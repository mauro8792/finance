PORT=3001
NODE_ENV=development
DATABASE_URL=postgresql://personal_finance:personal_finance@localhost:5432/personal_finance
DATABASE_URL_TEST=postgresql://personal_finance:personal_finance@localhost:5432/personal_finance_test
# Origen exacto del frontend. Obligatorio en production (fail-fast). Nunca *.
WEB_ORIGIN=http://localhost:3000
# Solo 1 detrás del proxy esperado (Render). No inferir de NODE_ENV.
TRUST_PROXY=
# Cookie de sesión. Mínimo 32 caracteres. Server-only.
SESSION_SECRET=
SESSION_COOKIE_NAME=pf_sid
SESSION_TTL_DAYS=7
# 1 en production/HTTPS. 0 en localhost HTTP.
SESSION_SECURE=0
# Solo para scripts auth:bootstrap / auth:set-password. Nunca commitear valores reales.
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
BOOTSTRAP_NAME=
# Server-only. Nunca NEXT_PUBLIC. Nunca loguear. 503 si falta al usar AI.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_MS=15000
OPENAI_MAX_RETRIES=2
