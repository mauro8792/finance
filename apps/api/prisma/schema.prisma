generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CategoryType {
  EXPENSE
  INCOME
  BOTH

  @@map("category_type_enum")
}

enum Currency {
  ARS
  USD

  @@map("currency_enum")
}

enum AccountType {
  CASH
  BANK
  FUND
  INVESTMENT
  HOUSING_RESERVE
  OTHER

  @@map("account_type_enum")
}

enum TransactionType {
  EXPENSE
  INCOME
  TRANSFER
  REIMBURSEMENT
  ADJUSTMENT
  INVESTMENT_OUTFLOW
  INVESTMENT_PRINCIPAL_RETURN
  INVESTMENT_RETURN
  CURRENCY_EXCHANGE
  HOUSING_PAYMENT
  CREDIT_CARD_PAYMENT

  @@map("transaction_type_enum")
}

enum TransactionStatus {
  ACTIVE
  VOIDED

  @@map("transaction_status_enum")
}

enum PaymentMethod {
  CASH
  DEBIT_CARD
  CREDIT_CARD
  BANK_TRANSFER
  DIGITAL_WALLET
  OTHER

  @@map("payment_method_enum")
}

enum ReimbursementStatus {
  NONE
  PENDING
  PARTIAL
  COMPLETED

  @@map("reimbursement_status_enum")
}

enum InvestmentType {
  CAUCION
  OTHER

  @@map("investment_type_enum")
}

enum InvestmentStatus {
  DRAFT
  ACTIVE
  MATURED
  RENEWED
  CANCELLED

  @@map("investment_status_enum")
}

enum CreditCardFeeStatus {
  HAS_FEE
  WAIVED
  POTENTIALLY_WAIVED
  UNKNOWN

  @@map("credit_card_fee_status_enum")
}

enum CreditCardPurchaseStatus {
  ACTIVE
  VOIDED

  @@map("credit_card_purchase_status_enum")
}

enum CreditCardInstallmentStatus {
  PENDING
  RECOGNIZED
  CANCELLED

  @@map("credit_card_installment_status_enum")
}

enum CreditCardStatementStatus {
  PROJECTED
  CLOSED
  PARTIALLY_PAID
  PAID

  @@map("credit_card_statement_status_enum")
}

enum CreditCardRefundExpectationStatus {
  EXPECTED
  PARTIALLY_ACCREDITED
  ACCREDITED
  CANCELLED

  @@map("credit_card_refund_expectation_status_enum")
}

enum CreditCardRefundDestinationType {
  BANK_ACCOUNT
  CREDIT_CARD

  @@map("credit_card_refund_destination_type_enum")
}

enum CreditCardPromotionBenefitType {
  PERCENTAGE
  FIXED_AMOUNT

  @@map("credit_card_promotion_benefit_type_enum")
}

enum CreditCardPromotionCapPeriod {
  NONE
  PER_PURCHASE
  MONTHLY
  PROMOTION_PERIOD

  @@map("credit_card_promotion_cap_period_enum")
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  name         String        @db.VarChar(120)
  email        String        @unique @db.VarChar(255)
  passwordHash String        @map("password_hash") @db.Text
  timezone     String        @default("America/Argentina/Buenos_Aires") @db.VarChar(100)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  accounts           Account[]
  categories         Category[]
  transactions       Transaction[]
  currencyExchanges  CurrencyExchange[]
  budgets            Budget[]
  housingObligations HousingObligation[]
  investments           Investment[]
  creditCards                      CreditCard[]
  creditCardPurchases              CreditCardPurchase[]
  creditCardStatements             CreditCardStatement[]
  creditCardPaymentLinks           CreditCardPaymentLink[]
  creditCardRefundExpectations     CreditCardRefundExpectation[]
  creditCardRefundAccreditations   CreditCardRefundAccreditation[]
  creditCardPromotions             CreditCardPromotion[]
  creditCardPromotionApplications  CreditCardPromotionApplication[]
  sessions                         Session[]

  @@map("users")
}

model Session {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash") @db.VarChar(64)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Category {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  name         String        @db.VarChar(120)
  type         CategoryType
  isSystem     Boolean       @default(false) @map("is_system")
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  transactions Transaction[]
  budgets      Budget[]
  creditCardPurchases CreditCardPurchase[]

  @@unique([userId, name])
  @@map("categories")
}

model Account {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  name           String        @db.VarChar(120)
  currency       Currency
  type           AccountType
  initialBalance Decimal       @default(0) @map("initial_balance") @db.Decimal(18, 2)
  isActive       Boolean       @default(true) @map("is_active")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  user                      User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  transactions              Transaction[]
  currencyExchangesFrom     CurrencyExchange[] @relation("CurrencyExchangeFrom")
  currencyExchangesTo       CurrencyExchange[] @relation("CurrencyExchangeTo")
  housingObligations        HousingObligation[]
  housingPayments           HousingPayment[]
  investments               Investment[]

  @@map("accounts")
}

model Transaction {
  id                    String              @id @default(uuid()) @db.Uuid
  userId                String              @map("user_id") @db.Uuid
  accountId             String?             @map("account_id") @db.Uuid
  creditCardId          String?             @map("credit_card_id") @db.Uuid
  categoryId            String?             @map("category_id") @db.Uuid
  type                  TransactionType
  status                TransactionStatus   @default(ACTIVE)
  amount                Decimal             @db.Decimal(18, 2)
  currency              Currency
  description           String?             @db.VarChar(255)
  occurredAt            DateTime            @map("occurred_at") @db.Timestamptz
  paymentMethod         PaymentMethod?      @map("payment_method")
  isFixed               Boolean             @default(false) @map("is_fixed")
  reimbursementStatus   ReimbursementStatus @default(NONE) @map("reimbursement_status")
  relatedTransactionId  String?             @map("related_transaction_id") @db.Uuid
  metadata              Json?               @db.JsonB
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  user                  User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  account               Account?            @relation(fields: [accountId], references: [id], onDelete: Restrict)
  creditCard            CreditCard?         @relation(fields: [creditCardId], references: [id], onDelete: Restrict)
  category              Category?           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  relatedTransaction    Transaction?        @relation("RelatedTransactions", fields: [relatedTransactionId], references: [id], onDelete: Restrict)
  relatedTransactions   Transaction[]       @relation("RelatedTransactions")
  housingPayment         HousingPayment?
  creditCardInstallment  CreditCardInstallment?
  creditCardPaymentLink  CreditCardPaymentLink?
  refundExpectationAsOriginalExpense CreditCardRefundExpectation[] @relation("RefundExpectationOriginalExpense")
  refundAccreditationsAsOriginalExpense CreditCardRefundAccreditation[] @relation("RefundAccreditationOriginalExpense")
  promotionApplicationsAsOriginalExpense CreditCardPromotionApplication[] @relation("PromotionApplicationOriginalExpense")
  refundAccreditation    CreditCardRefundAccreditation?

  @@index([userId, occurredAt])
  @@index([accountId, occurredAt])
  @@index([categoryId, occurredAt])
  @@index([userId, type, occurredAt])
  @@index([relatedTransactionId])
  @@index([creditCardId])
  @@map("transactions")
}

model CurrencyExchange {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  fromAccountId String   @map("from_account_id") @db.Uuid
  toAccountId   String   @map("to_account_id") @db.Uuid
  fromCurrency  Currency @map("from_currency")
  toCurrency    Currency @map("to_currency")
  fromAmount    Decimal  @map("from_amount") @db.Decimal(18, 2)
  toAmount      Decimal  @map("to_amount") @db.Decimal(18, 2)
  exchangeRate  Decimal  @map("exchange_rate") @db.Decimal(18, 6)
  occurredAt    DateTime @map("occurred_at") @db.Timestamptz
  description   String?  @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  user          User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  fromAccount   Account  @relation("CurrencyExchangeFrom", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount     Account  @relation("CurrencyExchangeTo", fields: [toAccountId], references: [id], onDelete: Restrict)

  @@index([userId, occurredAt])
  @@index([fromAccountId, occurredAt])
  @@index([toAccountId, occurredAt])
  @@map("currency_exchanges")
}

model Budget {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  currency   Currency
  amount     Decimal  @db.Decimal(18, 2)
  year       Int
  month      Int
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([userId, categoryId, currency, year, month])
  @@index([userId, year, month])
  @@map("budgets")
}

model HousingObligation {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @map("user_id") @db.Uuid
  reserveAccountId      String?  @map("reserve_account_id") @db.Uuid
  name                  String   @db.VarChar(120)
  currency              Currency
  installmentAmount     Decimal  @map("installment_amount") @db.Decimal(18, 2)
  remainingInstallments Int      @map("remaining_installments")
  dueDay                Int?     @map("due_day")
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz
  user                  User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  reserveAccount        Account? @relation(fields: [reserveAccountId], references: [id], onDelete: Restrict)
  payments              HousingPayment[]

  @@map("housing_obligations")
}

model HousingPayment {
  id                  String            @id @default(uuid()) @db.Uuid
  housingObligationId String            @map("housing_obligation_id") @db.Uuid
  transactionId       String            @unique @map("transaction_id") @db.Uuid
  accountId           String            @map("account_id") @db.Uuid
  amount              Decimal           @db.Decimal(18, 2)
  currency            Currency
  installmentNumber   Int?              @map("installment_number")
  paidAt              DateTime          @map("paid_at") @db.Timestamptz
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz
  housingObligation   HousingObligation @relation(fields: [housingObligationId], references: [id], onDelete: Restrict)
  transaction         Transaction       @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  account             Account           @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([housingObligationId, paidAt])
  @@map("housing_payments")
}

model Investment {
  id                       String           @id @default(uuid()) @db.Uuid
  userId                   String           @map("user_id") @db.Uuid
  accountId                String           @map("account_id") @db.Uuid
  renewedFromInvestmentId  String?          @map("renewed_from_investment_id") @db.Uuid
  type                     InvestmentType
  status                   InvestmentStatus
  currency                 Currency
  principal                Decimal          @db.Decimal(18, 2)
  annualRate               Decimal?         @map("annual_rate") @db.Decimal(12, 6)
  startDate                DateTime         @map("start_date") @db.Timestamptz
  maturityDate             DateTime?        @map("maturity_date") @db.Timestamptz
  expectedReturn           Decimal?         @map("expected_return") @db.Decimal(18, 2)
  actualReturn             Decimal?         @map("actual_return") @db.Decimal(18, 2)
  notes                    String?          @db.Text
  createdAt                DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  user                     User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  account                  Account          @relation(fields: [accountId], references: [id], onDelete: Restrict)
  renewedFrom              Investment?      @relation("InvestmentRenewal", fields: [renewedFromInvestmentId], references: [id], onDelete: Restrict)
  renewals                 Investment[]     @relation("InvestmentRenewal")

  @@index([userId, status])
  @@index([userId, maturityDate])
  @@index([accountId])
  @@index([renewedFromInvestmentId])
  @@map("investments")
}

model CreditCard {
  id          String              @id @default(uuid()) @db.Uuid
  userId      String              @map("user_id") @db.Uuid
  name        String              @db.VarChar(120)
  issuer      String              @db.VarChar(120)
  brand       String              @db.VarChar(40)
  currency    Currency
  isActive    Boolean             @default(true) @map("is_active")
  isPrimary   Boolean             @default(false) @map("is_primary")
  closingDay  Int?                @map("closing_day")
  dueDay      Int?                @map("due_day")
  feeStatus   CreditCardFeeStatus @default(UNKNOWN) @map("fee_status")
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  user         User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  transactions Transaction[]
  purchases    CreditCardPurchase[]
  statements   CreditCardStatement[]
  paymentLinks CreditCardPaymentLink[]
  refundExpectations   CreditCardRefundExpectation[]
  refundAccreditations CreditCardRefundAccreditation[]
  promotions           CreditCardPromotion[]

  @@index([userId])
  @@index([userId, isActive])
  @@map("credit_cards")
}

model CreditCardStatement {
  id                    String                     @id @default(uuid()) @db.Uuid
  userId                String                     @map("user_id") @db.Uuid
  creditCardId          String                     @map("credit_card_id") @db.Uuid
  currency              Currency
  periodStart           DateTime                   @map("period_start") @db.Timestamptz
  periodEnd             DateTime                   @map("period_end") @db.Timestamptz
  closingDate           DateTime                   @map("closing_date") @db.Timestamptz
  dueDate               DateTime?                  @map("due_date") @db.Timestamptz
  status                CreditCardStatementStatus  @default(PROJECTED)
  /// Snapshot of derived projection at close. Null while PROJECTED (live-derived).
  closedProjectedAmount Decimal?                   @map("closed_projected_amount") @db.Decimal(18, 2)
  actualAmount          Decimal?                   @map("actual_amount") @db.Decimal(18, 2)
  closedAt              DateTime?                  @map("closed_at") @db.Timestamptz
  createdAt             DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime                   @updatedAt @map("updated_at") @db.Timestamptz
  user                  User                       @relation(fields: [userId], references: [id], onDelete: Restrict)
  creditCard            CreditCard                 @relation(fields: [creditCardId], references: [id], onDelete: Restrict)
  paymentLinks          CreditCardPaymentLink[]

  @@unique([creditCardId, closingDate])
  @@index([userId, closingDate])
  @@index([creditCardId, status])
  @@map("credit_card_statements")
}

/// P0.10: links CREDIT_CARD_PAYMENT Transaction → optional statement + idempotency.
/// Amount SoT remains Transaction; this table does not duplicate amount.
model CreditCardPaymentLink {
  id             String               @id @default(uuid()) @db.Uuid
  userId         String               @map("user_id") @db.Uuid
  transactionId  String               @unique @map("transaction_id") @db.Uuid
  creditCardId   String               @map("credit_card_id") @db.Uuid
  statementId    String?              @map("statement_id") @db.Uuid
  idempotencyKey String               @map("idempotency_key") @db.VarChar(128)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz
  user           User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  transaction    Transaction          @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  creditCard     CreditCard           @relation(fields: [creditCardId], references: [id], onDelete: Restrict)
  statement      CreditCardStatement? @relation(fields: [statementId], references: [id], onDelete: Restrict)

  @@unique([userId, idempotencyKey])
  @@index([creditCardId, createdAt])
  @@index([statementId])
  @@map("credit_card_payment_links")
}

model CreditCardPurchase {
  id                 String                   @id @default(uuid()) @db.Uuid
  userId             String                   @map("user_id") @db.Uuid
  creditCardId       String                   @map("credit_card_id") @db.Uuid
  categoryId         String                   @map("category_id") @db.Uuid
  description        String?                  @db.VarChar(255)
  currency           Currency
  totalAmount        Decimal                  @map("total_amount") @db.Decimal(18, 2)
  installmentAmount  Decimal                  @map("installment_amount") @db.Decimal(18, 2)
  installmentsCount  Int                      @default(1) @map("installments_count")
  purchasedAt        DateTime                 @map("purchased_at") @db.Timestamptz
  status             CreditCardPurchaseStatus @default(ACTIVE)
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.Timestamptz
  user               User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  creditCard         CreditCard               @relation(fields: [creditCardId], references: [id], onDelete: Restrict)
  category           Category                 @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  installments       CreditCardInstallment[]
  refundExpectations     CreditCardRefundExpectation[]
  refundAccreditations   CreditCardRefundAccreditation[]
  promotionApplications  CreditCardPromotionApplication[]

  @@index([userId, purchasedAt])
  @@index([creditCardId, purchasedAt])
  @@index([userId, status])
  @@map("credit_card_purchases")
}

/// P0.11: expected credit-card refund (no financial impact until accreditation).
/// XOR: exactly one of purchaseId | originalExpenseTransactionId.
/// P0.12: cancelledRemainingAmount + optional promotion snapshot/link.
model CreditCardRefundExpectation {
  id                            String                            @id @default(uuid()) @db.Uuid
  userId                        String                            @map("user_id") @db.Uuid
  creditCardId                  String                            @map("credit_card_id") @db.Uuid
  purchaseId                    String?                           @map("purchase_id") @db.Uuid
  originalExpenseTransactionId  String?                           @map("original_expense_transaction_id") @db.Uuid
  expectedAmount                Decimal                           @map("expected_amount") @db.Decimal(18, 2)
  /// Cap release on cancel: max(0, expected - accredited). Default 0 until cancel.
  cancelledRemainingAmount      Decimal                           @default(0) @map("cancelled_remaining_amount") @db.Decimal(18, 2)
  currency                      Currency
  status                        CreditCardRefundExpectationStatus @default(EXPECTED)
  expectedDate                  DateTime?                         @map("expected_date") @db.Timestamptz
  description                   String?                           @db.VarChar(255)
  promotionId                   String?                           @map("promotion_id") @db.Uuid
  calculationEligibleBase       Decimal?                          @map("calculation_eligible_base") @db.Decimal(18, 2)
  calculationRawBenefit         Decimal?                          @map("calculation_raw_benefit") @db.Decimal(18, 2)
  calculationCapApplied         Decimal?                          @map("calculation_cap_applied") @db.Decimal(18, 2)
  calculationLimitedBy          String?                           @map("calculation_limited_by") @db.VarChar(40)
  calculationPercentage         Decimal?                          @map("calculation_percentage") @db.Decimal(18, 6)
  calculationFixedAmount        Decimal?                          @map("calculation_fixed_amount") @db.Decimal(18, 2)
  calculationPromotionName      String?                           @map("calculation_promotion_name") @db.VarChar(120)
  createdAt                     DateTime                          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                     DateTime                          @updatedAt @map("updated_at") @db.Timestamptz
  user                          User                              @relation(fields: [userId], references: [id], onDelete: Restrict)
  creditCard                    CreditCard                        @relation(fields: [creditCardId], references: [id], onDelete: Restrict)
  purchase                      CreditCardPurchase?               @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  originalExpenseTransaction    Transaction?                      @relation("RefundExpectationOriginalExpense", fields: [originalExpenseTransactionId], references: [id], onDelete: Restrict)
  promotion                     CreditCardPromotion?              @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  accreditations                CreditCardRefundAccreditation[]
  promotionApplication          CreditCardPromotionApplication?

  @@index([userId, status])
  @@index([creditCardId, createdAt])
  @@index([purchaseId])
  @@index([originalExpenseTransactionId])
  @@index([promotionId])
  @@map("credit_card_refund_expectations")
}

/// P0.12: credit-card promotion / refund benefit definition with optional caps.
model CreditCardPromotion {
  id                     String                         @id @default(uuid()) @db.Uuid
  userId                 String                         @map("user_id") @db.Uuid
  creditCardId           String                         @map("credit_card_id") @db.Uuid
  name                   String                         @db.VarChar(120)
  currency               Currency
  benefitType            CreditCardPromotionBenefitType @map("benefit_type")
  percentage             Decimal?                       @db.Decimal(18, 6)
  fixedAmount            Decimal?                       @map("fixed_amount") @db.Decimal(18, 2)
  minimumPurchaseAmount  Decimal?                       @map("minimum_purchase_amount") @db.Decimal(18, 2)
  capAmount              Decimal?                       @map("cap_amount") @db.Decimal(18, 2)
  capPeriod              CreditCardPromotionCapPeriod   @default(NONE) @map("cap_period")
  validFrom              DateTime                       @map("valid_from") @db.Timestamptz
  validUntil             DateTime                       @map("valid_until") @db.Timestamptz
  isActive               Boolean                        @default(true) @map("is_active")
  description            String?                        @db.VarChar(255)
  createdAt              DateTime                       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime                       @updatedAt @map("updated_at") @db.Timestamptz
  user                   User                           @relation(fields: [userId], references: [id], onDelete: Restrict)
  creditCard             CreditCard                     @relation(fields: [creditCardId], references: [id], onDelete: Restrict)
  expectations           CreditCardRefundExpectation[]
  applications           CreditCardPromotionApplication[]

  @@index([userId, isActive])
  @@index([creditCardId, validFrom, validUntil])
  @@map("credit_card_promotions")
}

/// P0.12: links a promotion apply → expectation (idempotent; one promo per source).
model CreditCardPromotionApplication {
  id                           String                      @id @default(uuid()) @db.Uuid
  userId                       String                      @map("user_id") @db.Uuid
  promotionId                  String                      @map("promotion_id") @db.Uuid
  expectationId                String                      @unique @map("expectation_id") @db.Uuid
  purchaseId                   String?                     @map("purchase_id") @db.Uuid
  originalExpenseTransactionId String?                     @map("original_expense_transaction_id") @db.Uuid
  idempotencyKey               String                      @map("idempotency_key") @db.VarChar(128)
  createdAt                    DateTime                    @default(now()) @map("created_at") @db.Timestamptz
  user                         User                        @relation(fields: [userId], references: [id], onDelete: Restrict)
  promotion                    CreditCardPromotion         @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  expectation                  CreditCardRefundExpectation @relation(fields: [expectationId], references: [id], onDelete: Restrict)
  purchase                     CreditCardPurchase?         @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  originalExpenseTransaction   Transaction?                @relation("PromotionApplicationOriginalExpense", fields: [originalExpenseTransactionId], references: [id], onDelete: Restrict)

  @@unique([userId, idempotencyKey])
  @@index([promotionId])
  @@index([purchaseId])
  @@index([originalExpenseTransactionId])
  @@map("credit_card_promotion_applications")
}

/// P0.11: links REIMBURSEMENT Transaction → optional expectation + idempotency.
/// Amount SoT remains Transaction; this table does not duplicate amount.
model CreditCardRefundAccreditation {
  id                            String                          @id @default(uuid()) @db.Uuid
  userId                        String                          @map("user_id") @db.Uuid
  transactionId                 String                          @unique @map("transaction_id") @db.Uuid
  expectationId                 String?                         @map("expectation_id") @db.Uuid
  originalExpenseTransactionId  String                          @map("original_expense_transaction_id") @db.Uuid
  purchaseId                    String?                         @map("purchase_id") @db.Uuid
  creditCardId                  String                          @map("credit_card_id") @db.Uuid
  destinationType               CreditCardRefundDestinationType @map("destination_type")
  idempotencyKey                String                          @map("idempotency_key") @db.VarChar(128)
  createdAt                     DateTime                        @default(now()) @map("created_at") @db.Timestamptz
  user                          User                            @relation(fields: [userId], references: [id], onDelete: Restrict)
  transaction                   Transaction                     @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  expectation                   CreditCardRefundExpectation?    @relation(fields: [expectationId], references: [id], onDelete: Restrict)
  originalExpenseTransaction    Transaction                     @relation("RefundAccreditationOriginalExpense", fields: [originalExpenseTransactionId], references: [id], onDelete: Restrict)
  purchase                      CreditCardPurchase?             @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  creditCard                    CreditCard                      @relation(fields: [creditCardId], references: [id], onDelete: Restrict)

  @@unique([userId, idempotencyKey])
  @@index([expectationId])
  @@index([creditCardId, createdAt])
  @@index([originalExpenseTransactionId])
  @@index([purchaseId])
  @@map("credit_card_refund_accreditations")
}

model CreditCardInstallment {
  id                       String                       @id @default(uuid()) @db.Uuid
  purchaseId               String                       @map("purchase_id") @db.Uuid
  installmentNumber        Int                          @map("installment_number")
  amount                   Decimal                      @db.Decimal(18, 2)
  status                   CreditCardInstallmentStatus  @default(PENDING)
  scheduledFor             DateTime                     @map("scheduled_for") @db.Timestamptz
  recognizedTransactionId  String?                      @unique @map("recognized_transaction_id") @db.Uuid
  recognizedAt             DateTime?                    @map("recognized_at") @db.Timestamptz
  createdAt                DateTime                     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime                     @updatedAt @map("updated_at") @db.Timestamptz
  purchase                 CreditCardPurchase           @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  recognizedTransaction    Transaction?                 @relation(fields: [recognizedTransactionId], references: [id], onDelete: Restrict)

  @@unique([purchaseId, installmentNumber])
  @@index([purchaseId])
  @@index([status])
  @@index([scheduledFor])
  @@map("credit_card_installments")
}
